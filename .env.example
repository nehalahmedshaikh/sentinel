# Application
SENTINEL_ENV=development
SENTINEL_API_HOST=127.0.0.1
SENTINEL_API_PORT=8000
SENTINEL_API_KEY=replace-with-a-long-random-secret

# Existing database configuration
SENTINEL_DATABASE_URL=postgresql+psycopg://YOUR_DB_USER@localhost/sentinel
SENTINEL_TEST_DATABASE_URL=postgresql+psycopg://YOUR_DB_USER@localhost/sentinel_test

# Existing managed data directory
SENTINEL_DATA_DIR=/home/YOUR_LINUX_USER/.local/share/sentinel

# Background execution
SENTINEL_REDIS_URL=redis://localhost:6379/0
SENTINEL_CELERY_CONCURRENCY=1
SENTINEL_UPLOAD_MAX_BYTES=50000000
SENTINEL_ALLOWED_FILE_TYPES=csv,parquet,json,jsonl,ndjson
SENTINEL_CORS_ORIGINS=
SENTINEL_TASK_MAX_RETRIES=3
SENTINEL_TASK_RETRY_DELAY_SECONDS=10
SENTINEL_SCHEDULE_DISPATCH_SECONDS=30
SENTINEL_OUTBOX_DISPATCH_SECONDS=2
SENTINEL_STALE_JOB_SECONDS=900

# AI — disabled until explicitly configured
SENTINEL_AI_ENABLED=false
SENTINEL_AI_BASE_URL=
SENTINEL_AI_API_KEY=
SENTINEL_AI_MODEL=
